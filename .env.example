# =============================================================================
# PermRepo — Environment Variables (TEMPLATE)
# PermRepo — Vides Mainīgie (PARAUGS)
# =============================================================================
# This is a TEMPLATE. Copy to .env and fill in your values:
# Šis ir PARAUGS. Kopē uz .env un aizpildi ar savām vērtībām:
#   cp .env.example .env
#
# 🔴 NEVER commit the .env file!
# 🔴 NEKAD necommito .env failu!
#
# ✅ .env.example CAN be committed (no secrets)
# ✅ .env.example VAR commitēt (bez secrets)
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub OAuth
# -----------------------------------------------------------------------------
# Get from: https://github.com/settings/developers
# Iegūsti no: https://github.com/settings/developers
# 1. New OAuth App
# 2. Authorization callback URL: https://your-domain.com/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=https://your-domain.com/api/github/callback

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Ģenerē ar: openssl rand -hex 32
# Minimum length: 32 characters
# Minimālais garums: 32 rakstzīmes
SESSION_SECRET=your_32_char_session_secret_here

# -----------------------------------------------------------------------------
# Redis (Upstash)
# -----------------------------------------------------------------------------
# Get from: https://console.upstash.com
# Iegūsti no: https://console.upstash.com
# 1. Create Database / Izveido Database
# 2. Copy REST URL and REST TOKEN / Kopē REST URL un REST TOKEN
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# -----------------------------------------------------------------------------
# Redis TTL (time parameters)
# Redis TTL (laika parametri)
# -----------------------------------------------------------------------------
# Job TTL — how long backup job is stored in Redis (seconds)
# Job TTL — cik ilgi backup job glabājas Redis (sekundes)
# Default: 3600 (1 hour)
# Noklusējums: 3600 (1 stunda)
JOB_TTL_SECONDS=3600

# Job Lock TTL — how long job lock is held in Redis (seconds)
# Job Lock TTL — cik ilgi job slēdzeni tur Redis (sekundes)
# Default: 300 (5 minutes)
# Noklusējums: 300 (5 minūtes)
# Recommended: 600 (10 minutes) for large ZIPs
# Ieteicams: 600 (10 minūtes) lieliem ZIP
JOB_LOCK_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Blockchain (Base)
# -----------------------------------------------------------------------------
# Base mainnet:
#   CHAIN_ID=8453
#   RPC_URL=https://mainnet.base.org
#
# Base Sepolia (testnet):
#   CHAIN_ID=84532
#   RPC_URL=https://sepolia.base.org

# Chain ID / Ķēdes ID
CHAIN_ID=8453

# RPC URL (Base)
# Get from: https://www.alchemy.com or https://quicknode.com
# Iegūsti no: https://www.alchemy.com vai https://quicknode.com
RPC_URL=https://mainnet.base.org

# NFT contract address
# NFT kontrakta adrese
NFT_ADDRESS=0x0000000000000000000000000000000000000000

# Subscription contract address
# Subscription kontrakta adrese
SUBSCRIPTION_ADDRESS=0x0000000000000000000000000000000000000000

# USDC contract address (Base)
# USDC kontrakta adrese (Base)
# Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# -----------------------------------------------------------------------------
# Arweave / Turbo
# -----------------------------------------------------------------------------
# Arweave gateway (for reading data)
# Arweave gateway (datu lasīšanai)
ARWEAVE_GATEWAY=https://arweave.net

# Turbo Upload URL (for uploading data)
# Turbo Upload URL (datu augšupielādei)
# Mainnet: https://upload.ardrive.io
# Sandbox: https://upload.services.ar-io.dev
TURBO_UPLOAD_URL=https://upload.ardrive.io

# Turbo Payment URL (for payments)
# Turbo Payment URL (maksājumiem)
# Mainnet: https://payment.ardrive.io
# Sandbox: https://payment.services.ar-io.dev
TURBO_PAYMENT_URL=https://payment.ardrive.io

# =============================================================================
# ADDITIONAL VARIABLES (optional, but can be set)
# PAPILDU MAINĪGIE (nav obligāti, bet var iestatīt)
# =============================================================================
# These variables are NOT in your list, but server.js supports them.
# Šie mainīgie NAV tavā sarakstā, bet server.js tos atbalsta.
# If not set, default values are used.
# Ja nav iestatīti, tiek izmantotas noklusējuma vērtības.
# =============================================================================

# -----------------------------------------------------------------------------
# Limits / Limiti
# -----------------------------------------------------------------------------
# Maximum number of files in repo
# Maksimālais failu skaits repo
# Default / Noklusējums: 5000
# MAX_REPO_FILES=5000

# Maximum repo size in bytes
# Maksimālais repo lielums baitos
# Default / Noklusējums: 524288000 (500 MB)
# MAX_REPO_BYTES=524288000

# Maximum single file size in bytes
# Maksimālais viena faila lielums baitos
# Default / Noklusējums: 104857600 (100 MB)
# MAX_FILE_BYTES=104857600

# Maximum GitHub ZIP size in bytes
# Maksimālais GitHub ZIP lielums baitos
# Default / Noklusējums: 629145600 (600 MB)
# MAX_ZIP_BYTES=629145600

# -----------------------------------------------------------------------------
# Resource Management (RAM queue)
# Resursu Pārvaldība (RAM rinda)
# -----------------------------------------------------------------------------
# What % of total RAM to use for backup operations
# Cik % no kopējās RAM izmantot backup operācijām
# Default / Noklusējums: 0.60 (60%)
# RESOURCE_MEMORY_BUDGET_RATIO=0.60

# Fixed RAM overhead per backup (in bytes)
# Fiksētais RAM overhead uz vienu backup (baitos)
# Default / Noklusējums: 33554432 (32 MB)
# RESOURCE_MEMORY_OVERHEAD_BYTES=33554432

# RAM multiplier (how many times RAM is used per file)
# RAM reizinātājs (cik reizes RAM patērē uz vienu failu)
# Default / Noklusējums: 2.60
# RESOURCE_MEMORY_MULTIPLIER=2.60

# Minimum RAM reservation per backup (in bytes)
# Minimālā RAM rezervācija vienam backup (baitos)
# Default / Noklusējums: 8388608 (8 MB)
# MIN_BACKUP_MEMORY_RESERVATION_BYTES=8388608

# Maximum queue size (how many users can wait)
# Maksimālais rindas lielums (cik lietotāju var gaidīt)
# Default / Noklusējums: 200
# MAX_BACKUP_QUEUE=200

# Queue heartbeat (how often to send status to client, ms)
# Queue heartbeat (cik bieži sūtīt statusu klientam, ms)
# Default / Noklusējums: 15000 (15s)
# RESOURCE_QUEUE_HEARTBEAT_MS=15000

# -----------------------------------------------------------------------------
# Session TTL
# -----------------------------------------------------------------------------
# Session TTL (how long user session is active, seconds)
# Session TTL (cik ilgi lietotāja sesija ir aktīva, sekundes)
# Default / Noklusējums: 3600 (1 hour / 1 stunda)
# SESSION_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Server Port
# Servera Ports
# -----------------------------------------------------------------------------
# Server port
# Servera ports
# Default / Noklusējums: 3000
# PORT=3000
