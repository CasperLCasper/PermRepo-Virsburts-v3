# Turbo Payment URL (Base Sepolia / testnet).
# Turbo Payment URL (Base Sepolia / testnet).
# Turbo Paga URL (Base Sepolia / testreto).
TURBO_PAYMENT_URL=https://payment.services.ar-io.dev

# GitHub OAuth Client ID.
# GitHub OAuth klienta ID.
# GitHub OAuth Klienta ID.
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth Client Secret.
# GitHub OAuth klienta noslēpums.
# GitHub OAuth Klienta Sekreto.
