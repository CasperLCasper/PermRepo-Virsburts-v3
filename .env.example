# GitHub OAuth Redirect URI.
# GitHub OAuth pāradresācijas URI.
# GitHub OAuth Redirekta URI.
GITHUB_REDIRECT_URI=https://your-domain.com/api/github/callback

# Session secret key for signing cookies.
# Sesijas slepenā atslēga sīkdatņu parakstīšanai.
# Sesia sekreta ŝlosilo por subskribi kuketojn.
SESSION_SECRET=your_32_char_session_secret_here

# Upstash Redis REST URL.
